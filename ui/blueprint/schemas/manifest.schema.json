{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rea.local/schema/blueprint/manifest.schema.json",
  "title": "Blueprint package manifest",
  "description": "The tamper-evident file list of a blueprint package (R10). produced_at is recorded but never part of a digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "ceiling",
    "ceiling_requested",
    "downgraded_by",
    "denominators",
    "determinism",
    "compiler",
    "produced_at",
    "digests",
    "files"
  ],
  "properties": {
    "schema": { "type": "string", "const": "rea.blueprint.manifest" },
    "schema_version": { "type": "integer", "const": 1 },
    "ceiling": {
      "type": "string",
      "enum": ["executed", "statically-evidenced", "inferred-only"]
    },
    "ceiling_requested": {
      "type": "string",
      "enum": ["executed", "statically-evidenced", "inferred-only"]
    },
    "downgraded_by": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*:[a-z0-9-]+$" }
    },
    "denominators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "classes"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "classes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "items", "probe"],
            "properties": {
              "class": { "type": "string", "minLength": 1 },
              "items": { "type": "integer", "minimum": 0 },
              "probe": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sort", "produced_at", "zip_timestamps", "clock", "scope"],
      "properties": {
        "sort": { "type": "string", "minLength": 1 },
        "produced_at": { "type": "string", "minLength": 1 },
        "zip_timestamps": { "type": "string", "minLength": 1 },
        "clock": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ceiling", "downgraded_by"],
          "properties": {
            "ceiling": {
              "type": "string",
              "enum": ["executed", "statically-evidenced", "inferred-only"]
            },
            "downgraded_by": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*:[a-z0-9-]+$" }
            }
          }
        }
      }
    },
    "compiler": { "type": "string", "minLength": 1 },
    "analysis_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "produced_at": { "type": "string", "format": "date-time" },
    "digests": {
      "type": "object",
      "required": ["package"],
      "properties": {
        "package": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "blueprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)[^\\\\]*$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
